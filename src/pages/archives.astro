---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="归档 · 来开博客" description="来开博客全部文章的按年归档">
  <div class="container">
    <h1 class="page-title">归档</h1>
    <p class="page-sub">共 {posts.length} 篇</p>
    <div class="timeline">
      {
        years.map(([year, yearPosts]) => (
          <section class="year-group">
            <h2 class="year">{year}<span class="year-count">{yearPosts.length} 篇</span></h2>
            <ul class="post-list">
              {yearPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`} class="row">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}
                    </time>
                    <span class="row-title">{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 4rem 0 0.3rem;
  }

  .page-sub {
    color: var(--text-tertiary);
    font-size: 0.95rem;
    margin: 0 0 2.5rem;
  }

  .timeline {
    margin-bottom: 3rem;
  }

  .year-group {
    position: relative;
    padding-left: 1.6rem;
    border-left: 2px solid var(--border);
  }

  .year {
    position: relative;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .year::before {
    content: '';
    position: absolute;
    left: -2.1rem;
    top: 0.55rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .year-count {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-family: var(--font-sans);
    margin-left: 0.7rem;
    font-weight: 400;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding: 0.65rem 0.4rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }

  .row:hover {
    background: var(--bg-secondary);
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  time {
    font-size: 0.84rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    font-family: var(--font-mono);
    min-width: 4.5em;
  }

  .row-title {
    font-size: 1rem;
    font-weight: 550;
    transition: color 0.2s ease;
  }
</style>
