---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [latest, ...rest] = posts;
---

<BaseLayout title="来开博客" description="一个记录技术与生活的个人博客">
  <div class="container">
    <section class="hero">
      <h1 class="hero-title">
        记录技术<br />探索与思考。
      </h1>
      <p class="hero-sub">
        踩过的坑、解决过的问题、值得留存的 idea。<a href="/rss.xml">RSS 订阅</a>不错过任何更新。
      </p>
    </section>
  </div>

  {
    latest && (
      <div class="container">
        <section class="section">
          <h2 class="section-label">最新文章</h2>
          <a href={`/blog/${latest.id}/`} class="featured">
            <time datetime={latest.data.pubDate.toISOString()}>
              {latest.data.pubDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h3 class="featured-title">{latest.data.title}</h3>
            <p class="featured-desc">{latest.data.description}</p>
            {latest.data.tags.length > 0 && (
              <div class="tag-row">
                {latest.data.tags.map((tag) => (
                  <span class="meta-tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </section>
      </div>
    )
  }

  {
    rest.length > 0 && (
      <div class="band">
        <div class="container">
          <section class="section">
            <h2 class="section-label">更多文章</h2>
            <ul class="post-list">
              {rest.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`} class="row">
                    <div class="row-text">
                      <h3 class="row-title">{post.data.title}</h3>
                      <p class="row-desc">{post.data.description}</p>
                      {post.data.tags.length > 0 && (
                        <div class="tag-row">
                          {post.data.tags.map((tag) => (
                            <span class="meta-tag">{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding: 5.5rem 0 4.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    background: linear-gradient(92deg, var(--text) 55%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 30em;
    margin: 0;
    line-height: 1.65;
  }

  .hero-sub a {
    color: var(--accent);
    text-decoration: none;
  }

  .hero-sub a:hover {
    text-decoration: underline;
  }

  .section {
    padding: 2.25rem 0 3rem;
  }

  .section-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    margin: 0 0 1.1rem;
  }

  /* 最新文章大卡：Apple 式大圆角浅灰底 */
  .featured {
    display: block;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease;
  }

  .featured:hover {
    transform: scale(1.01);
  }

  .featured time {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .featured-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 0.55rem;
  }

  .featured:hover .featured-title {
    color: var(--accent);
  }

  .featured-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.02rem;
    max-width: 40em;
  }

  /* 更多文章：大留白行式列表 */
  .band {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  li:last-child .row {
    border-bottom: none;
  }

  .row-title {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin: 0 0 0.3rem;
    transition: color 0.2s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.93rem;
  }

  .row time {
    font-size: 0.83rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  .tag-row {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.7rem;
    flex-wrap: wrap;
  }

  .meta-tag {
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.08rem 0.65rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3.5rem 0 3rem;
    }

    .featured {
      padding: 1.6rem 1.5rem;
    }

    .featured-title {
      font-size: 1.4rem;
    }

    .row {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
