---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const byTag = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }

  return [...byTag.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag} · 来开博客`} description={`标签「${tag}」下的全部文章`}>
  <h1 class="page-title">标签：<span class="accent">{tag}</span></h1>
  <p class="count-hint">{posts.length} 篇文章</p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}/`} class="post-link">
            <h2 class="post-title">{post.data.title}</h2>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <p class="post-description">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-title {
    font-size: 1.6rem;
    margin: 2.5rem 0 0.25rem;
  }

  .accent {
    color: var(--accent);
  }

  .count-hint {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0 0 1.5rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.75rem;
  }

  .post-link {
    text-decoration: none;
    color: inherit;
  }

  .post-title {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  time {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .post-description {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
  }
</style>
