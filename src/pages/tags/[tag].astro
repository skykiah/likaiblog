---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const byTag = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }

  return [...byTag.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag} · 来开博客`} description={`标签「${tag}」下的全部文章`}>
  <div class="container">
    <h1 class="page-title">{tag}</h1>
    <p class="page-sub">
      {posts.length} 篇文章 · <a href="/tags/">全部标签</a>
    </p>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="row">
              <div class="row-text">
                <h2 class="row-title">{post.data.title}</h2>
                <p class="row-desc">{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.2rem, 6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 4rem 0 0.3rem;
    color: var(--accent);
  }

  .page-sub {
    color: var(--text-tertiary);
    font-size: 0.95rem;
    margin: 0 0 2rem;
  }

  .page-sub a {
    color: var(--accent);
    text-decoration: none;
  }

  .page-sub a:hover {
    text-decoration: underline;
  }

  .post-list {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  li:last-child .row {
    border-bottom: none;
  }

  .row-title {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin: 0 0 0.3rem;
    transition: color 0.2s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.93rem;
  }

  .row time {
    font-size: 0.83rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      gap: 0.3rem;
    }
  }
</style>
