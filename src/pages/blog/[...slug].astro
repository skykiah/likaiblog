---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} · 来开博客`} description={post.data.description}>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        {
          post.data.tags.length > 0 && (
            <span class="meta-tags">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}/`} class="meta-tag">
                  {tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Giscus />
</BaseLayout>

<style>
  .post-header {
    margin: 3rem 0 2.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .meta-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .meta-tag {
    font-size: 0.75rem;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.08rem 0.7rem;
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .meta-tag:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .post-title {
    font-size: 2rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 0.6rem;
  }

  .post-lead {
    margin: 0;
    font-size: 1.02rem;
    color: var(--text-muted);
    max-width: 36em;
  }

  .prose {
    font-size: 1.02rem;
    line-height: 1.85;
    max-width: 68ch;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin: 2.5rem 0 0.9rem;
    padding-left: 0.7rem;
    border-left: 3px solid var(--accent);
    line-height: 1.4;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin: 2rem 0 0.6rem;
  }

  .prose :global(p) {
    margin: 0.9rem 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .prose :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.5rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
    color: var(--text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0.25rem 0;
  }

  .prose :global(code) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.12em 0.4em;
    font-size: 0.86em;
    font-family: var(--font-mono);
  }

  .prose :global(pre) {
    border-radius: 10px;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.7;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
  }

  .prose :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.25rem 0;
  }

  .prose :global(table) {
    border-collapse: collapse;
    margin: 1.25rem 0;
    width: 100%;
    font-size: 0.92rem;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.45rem 0.8rem;
    text-align: left;
  }

  .prose :global(th) {
    background: var(--code-bg);
    font-weight: 600;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.6rem;
  }

  .prose :global(li) {
    margin: 0.3rem 0;
  }
</style>
