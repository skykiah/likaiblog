---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} · 来开博客</title>
    <meta name="description" content={post.data.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="来开博客"
      href="/rss.xml"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="container">
        <a href="/" class="site-title">← 来开博客</a>
        <a href="/rss.xml" class="rss-link">RSS</a>
      </nav>
    </header>

    <main class="container">
      <article>
        <header class="post-header">
          <h1 class="post-title">{post.data.title}</h1>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} 来开博客 · <a href="/rss.xml">RSS 订阅</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --text: #1f2430;
    --text-muted: #6b7280;
    --accent: #4f6ef7;
    --border: #e5e7eb;
    --bg: #ffffff;
    --code-bg: #f6f8fa;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #e6e8ee;
      --text-muted: #9aa1ad;
      --accent: #8fa3ff;
      --border: #2a3040;
      --bg: #14171f;
      --code-bg: #1d2230;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      'PingFang SC',
      'Hiragino Sans GB',
      'Microsoft YaHei',
      sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
  }

  .container {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .site-header nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .site-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .site-title:hover {
    color: var(--accent);
  }

  .rss-link {
    color: var(--accent);
    text-decoration: none;
  }

  .rss-link:hover {
    text-decoration: underline;
  }

  main {
    padding-bottom: 3rem;
  }

  .post-header {
    margin: 2.5rem 0 2rem;
  }

  .post-title {
    font-size: 1.75rem;
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }

  .post-header time {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
  }

  .prose :global(p) {
    margin: 0.75rem 0;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
  }

  .prose :global(code) {
    background: var(--code-bg);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .site-footer a {
    color: var(--accent);
  }
</style>
