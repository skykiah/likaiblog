---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} · 来开博客`} description={post.data.description}>
  <div class="container">
    <article>
      <header class="post-header">
        <div class="meta-tags">
          {
            post.data.tags.map((tag) => (
              <a href={`/tags/${tag}/`} class="meta-tag">
                {tag}
              </a>
            ))
          }
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lead">{post.data.description}</p>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <Giscus />
  </div>
</BaseLayout>

<style>
  .post-header {
    padding: 4rem 0 2.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .meta-tag {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    text-decoration: none;
    transition: filter 0.2s ease;
  }

  .meta-tag:hover {
    filter: brightness(0.95);
  }

  .post-title {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.75rem;
  }

  .post-lead {
    font-size: 1.12rem;
    color: var(--text-secondary);
    max-width: 36em;
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }

  .post-header time {
    font-size: 0.87rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  /* ---- 正文：宽松、现代 ---- */
  .prose {
    font-size: 1.06rem;
    line-height: 1.9;
    max-width: 40em;
    padding-bottom: 1rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 3rem 0 1rem;
    line-height: 1.35;
  }

  .prose :global(h3) {
    font-size: 1.22rem;
    font-weight: 650;
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(p) {
    margin: 1.1rem 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .prose :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--text-secondary);
    font-size: 0.98em;
  }

  .prose :global(blockquote p) {
    margin: 0.5rem 0;
  }

  .prose :global(code) {
    background: var(--code-bg);
    border-radius: 6px;
    padding: 0.15em 0.45em;
    font-size: 0.85em;
    font-family: var(--font-mono);
  }

  .prose :global(pre) {
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.75;
    max-width: 52em;
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.75rem 0;
  }

  .prose :global(table) {
    border-collapse: collapse;
    margin: 1.5rem 0;
    width: 100%;
    font-size: 0.94rem;
    max-width: 52em;
  }

  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--border);
    padding: 0.55rem 0.9rem;
    text-align: left;
  }

  .prose :global(th) {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.88em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.6rem;
  }

  .prose :global(li) {
    margin: 0.45rem 0;
  }

  .prose :global(li::marker) {
    color: var(--text-tertiary);
  }
</style>
