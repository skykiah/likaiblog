---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="友链 · 来开博客" description="来开博客的朋友站点列表">
  <h1 class="page-title">友链</h1>
  <p class="intro">
    这里收录朋友们的站点。想交换友链的话，给本站仓库提
    <a href="https://github.com/skykiah/likaiblog">issue</a>
    或邮件联系我，附上站点名称、链接和一句话介绍即可。
  </p>
  <ul class="friend-list">
    <li class="friend-item">
      <a href="https://astro.build/" class="friend-link" rel="noopener">
        <span class="friend-name">Astro</span>
        <span class="friend-desc">本站的构建框架，内容站点的首选</span>
      </a>
    </li>
  </ul>
</BaseLayout>

<style>
  .page-title {
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    margin: 3rem 0 0.75rem;
  }

  .intro {
    color: var(--text-muted);
    margin: 0 0 2rem;
    max-width: 36em;
  }

  .intro a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .intro a:hover {
    border-bottom-color: var(--accent);
  }

  .friend-list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .friend-item {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .friend-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  .friend-link {
    display: block;
    padding: 1.05rem 1.3rem;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }

  .friend-name {
    display: block;
    font-weight: 600;
    color: var(--accent);
  }

  .friend-desc {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }
</style>
